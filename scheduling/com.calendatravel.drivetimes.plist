<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job: run the drive-time sync every 15 minutes.

  Install:
    cp scheduling/com.calendatravel.drivetimes.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.calendatravel.drivetimes.plist

  Run once now / check / remove:
    launchctl start com.calendatravel.drivetimes
    launchctl list | grep calendatravel
    launchctl unload ~/Library/LaunchAgents/com.calendatravel.drivetimes.plist

  To change frequency, edit StartInterval below (seconds). Examples:
    900 = 15 min, 1800 = 30 min, 3600 = 1 hour

  Logs go to drive-sync.log in the CalendarTravel folder (gitignored).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.calendatravel.drivetimes</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/tristan/Projects/CalendarTravel/scripts/run-sync.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>/Users/tristan/Projects/CalendarTravel/drive-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tristan/Projects/CalendarTravel/drive-sync.log</string>
</dict>
</plist>
