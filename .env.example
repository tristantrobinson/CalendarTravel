# Google Calendar drive-time sync — copy to .env and fill in.

# Address used as the drive origin when there is no suitable prior event.
HOME_ADDRESS="123 Main St, Your City, ST"

# Calendar to READ events from. "primary" is your main calendar.
SOURCE_CALENDAR_ID="primary"

# Calendar to WRITE travel blocks into (the separate "Drive Times" calendar).
# Find it in Google Calendar → Settings → <calendar> → Integrate calendar → Calendar ID.
TRAVEL_CALENDAR_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@group.calendar.google.com"

# API key restricted to the Routes API.
GOOGLE_MAPS_API_KEY="AIza..."

# How many days ahead to sync.
LOOKAHEAD_DAYS=7

# Skip travel blocks shorter than this (minutes) — ignores trivial hops.
MIN_DRIVE_MINUTES=5

# Max minutes between a prior event ending and the next event starting to
# chain the drive from the prior event's location instead of HOME_ADDRESS.
ORIGIN_GAP_MINUTES=180
